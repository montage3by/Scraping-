# Copy to .env and fill in before deploying (docker-compose.yml reads this file).
# Everything here has a safe fallback for local/dev use — see the comment on each.

# Resend (email delivery). Without this, backend/email_sender.py logs a
# DRY RUN instead of sending — safe default, but no real emails go out.
RESEND_API_KEY=
EMAIL_FROM=Daily Yolk <reports@dailyyolk.example>

# Residential proxy / antidetect service, for collectors that need to look
# like a real user (see plans/2026-08-26-repas-program-plan.md, Phase 1-2).
# Collectors don't read these yet — added here so the format is decided
# before it's needed, not improvised mid-deploy.
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Telegram (negative-review alerts + article channel, see
# marketing/article_pipeline/). Get via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Own blog (Phase 1 — WordPress or Ghost, whichever gets picked).
# Fill in whichever pair matches the platform actually deployed.
BLOG_API_URL=
BLOG_API_KEY=

# Meta (Instagram/Facebook posting — see Phase 0, needs App Review first).
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Only needed if/when sentiment analysis moves from the current keyword
# heuristic (report/analysis.py) to an LLM pass.
ANTHROPIC_API_KEY=

# Shared SQLite path between the backend and worker containers — matches
# docker-compose.yml, no reason to change unless the volume layout changes.
QUEUE_DB_PATH=/app/backend/_data/queue.db
